<idea-plugin>
    <id>git.multibranch</id>
    <name>Multi-Branch Commit &amp; Push</name>
    <version>1.1.5</version>
    <vendor email="altuzh@users.noreply.github.com" url="https://github.com/altuzh/git-multibranch-plugin">Alexey Tuzhikov</vendor>

    <description><![CDATA[
    Automated Multi-Branch Git workflow plugin for IntelliJ IDEA:
    <ul>
        <li>Selects changes from the <b>'Changes'</b> changelist (ignoring other changelists like 'New changelist')</li>
        <li>Creates 4 branches (dev, test, uat, prod) from origin tracking branches (origin/deploy/dev, origin/deploy/test, origin/merge_to_uat, origin/merge_to_prod)</li>
        <li>Commits changes across all 4 branches safely without disrupting the working tree</li>
        <li>Pushes branches to origin with upstream tracking</li>
        <li>Generates clickable GitLab Merge Request or GitHub Pull Request creation links with target branches pre-selected</li>
        <li>Supports dynamic hot-reloading without IDE restart</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="MultiBranchPlugin" displayType="BALLOON"/>
        <projectService serviceImplementation="git.multibranch.MultiBranchSettings"/>
        <projectConfigurable parentId="project.propVCSSettings"
                             instance="git.multibranch.MultiBranchSettingsConfigurable"
                             id="git.multibranch.MultiBranchSettingsConfigurable"
                             displayName="Multi-Branch Workflow"
                             nonDefaultProject="false"/>
        <statusBarWidgetFactory id="git.multibranch.widget"
                                implementation="git.multibranch.MultiBranchStatusBarWidgetFactory"/>
    </extensions>

    <actions>
        <action id="git.multibranch.MultiBranchCommitAction"
                class="git.multibranch.MultiBranchCommitAction"
                text="Multi-Branch Commit &amp; Push..."
                description="Create 4 branches from origins and commit changes from 'Changes' changelist">
            <add-to-group group-id="Git.MainMenu" anchor="after" relative-to-action="Git.Commit"/>
            <add-to-group group-id="ChangesViewPopupMenu" anchor="first"/>
            <add-to-group group-id="ChangesViewToolbar" anchor="last"/>
            <add-to-group group-id="Git.Experimental.Branch.Popup.Actions" anchor="first"/>
            <add-to-group group-id="GitRepositoryActions" anchor="first"/>
            <add-to-group group-id="Git.ContextMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt M"/>
        </action>
        <action id="git.multibranch.MultiBranchReloadAction"
                class="git.multibranch.MultiBranchReloadAction"
                text="Multi-Branch: Reload Plugin from Disk"
                description="Dynamically reloads the Multi-Branch plugin from the latest build distribution without restarting IDEA">
            <add-to-group group-id="Git.MainMenu" anchor="after" relative-to-action="git.multibranch.MultiBranchCommitAction"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
